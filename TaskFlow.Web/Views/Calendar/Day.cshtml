@model DayViewModel
@{
    var day = Model.Day;
    var date = day.Date.ToString("yyyy-MM-dd");
    var (dayLabel, dayCss, dayIcon) = Display.Of(day.Status);
    ViewData["Title"] = Display.LongDate(day.Date);
    ViewData["Subtitle"] = day.Date == Model.Today ? "Hoy" : day.Date < Model.Today ? "Día pasado" : "Día futuro";
    var prev = day.Date.AddDays(-1).ToString("yyyy-MM-dd");
    var next = day.Date.AddDays(1).ToString("yyyy-MM-dd");
}

@section TopActions {
    <div class="btn-group">
        <a class="btn btn-soft" asp-action="Day" asp-route-date="@prev" aria-label="Día anterior"><i class="bi bi-chevron-left"></i></a>
        <a class="btn btn-soft" asp-action="Index" asp-route-year="@day.Date.Year" asp-route-month="@day.Date.Month"><i class="bi bi-calendar3"></i></a>
        <a class="btn btn-soft" asp-action="Day" asp-route-date="@next" aria-label="Día siguiente"><i class="bi bi-chevron-right"></i></a>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="tf-card tf-card-body h-100 d-flex flex-column justify-content-center fade-up">
            <div class="text-muted small mb-2">Estado del día</div>
            <div><span class="st-chip @dayCss fs-6"><i class="bi @dayIcon"></i> @dayLabel</span></div>
        </div>
    </div>
    <div class="col-6 col-md-2"><div class="tf-card tf-card-body text-center fade-up"><div class="tf-stat-value">@day.ScheduledCount</div><div class="tf-stat-label">Programadas</div></div></div>
    <div class="col-6 col-md-2"><div class="tf-card tf-card-body text-center fade-up"><div class="tf-stat-value" style="color:var(--st-completed)">@day.CompletedCount</div><div class="tf-stat-label">Completadas</div></div></div>
    <div class="col-6 col-md-2"><div class="tf-card tf-card-body text-center fade-up"><div class="tf-stat-value" style="color:var(--st-failed)">@day.NotCompletedCount</div><div class="tf-stat-label">No completadas</div></div></div>
    <div class="col-6 col-md-2"><div class="tf-card tf-card-body text-center fade-up"><div class="tf-stat-value" style="color:var(--st-progress)">@(day.PendingCount + day.UnrecordedCount)</div><div class="tf-stat-label">@(day.Date == Model.Today ? "Pendientes" : "Sin registro")</div></div></div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="tf-card tf-card-body fade-up">
            <h3 class="tf-card-title"><i class="bi bi-list-task text-primary"></i> Actividades</h3>

            @if (day.Activities.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-calendar2 fs-1 d-block mb-2 opacity-50"></i>
                    No hay actividades programadas este día.
                </div>
            }

            @foreach (var a in day.Activities)
            {
                var (label, chip, icon) = Display.Of(a.Status);
                var hasRecord = a.Status is ActivityDayStatus.Completed or ActivityDayStatus.NotCompleted;
                <div class="tf-task flex-column flex-sm-row">
                    <div class="tf-task-check @(a.Status == ActivityDayStatus.Completed ? "bg-soft-success" : a.Status == ActivityDayStatus.NotCompleted ? "bg-soft-danger" : "bg-soft-primary")">
                        <i class="bi @icon"></i>
                    </div>
                    <div class="flex-grow-1 w-100">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <strong>@a.Name</strong>
                            <span class="chip @chip">@label</span>
                        </div>
                        <div class="text-muted small mt-1">
                            <i class="bi bi-clock me-1"></i>@Display.Time(a.StartTime) – @Display.Time(a.EndTime)
                            @if (a.ActualEndTime is { } end) { <span class="ms-2"><i class="bi bi-flag me-1"></i>terminó @Display.Time(end)</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(a.Notes)) { <div class="small mt-1"><i class="bi bi-chat-left-text me-1 text-muted"></i>@a.Notes</div> }

                        @if (Model.CanRecord)
                        {
                            @* Acciones rápidas: un clic. La hora real y la nota van en un desplegable. *@
                            <div class="tf-task-actions">
                                @if (a.Status != ActivityDayStatus.Completed)
                                {
                                    <form asp-action="Record" method="post">
                                        <input type="hidden" name="activityId" value="@a.ActivityId" />
                                        <input type="hidden" name="date" value="@date" />
                                        <input type="hidden" name="status" value="Completed" />
                                        <input type="hidden" name="notes" value="@a.Notes" />
                                        <button class="btn btn-soft-success btn-sm"><i class="bi bi-check-lg me-1"></i>Completada</button>
                                    </form>
                                }
                                @if (a.Status != ActivityDayStatus.NotCompleted)
                                {
                                    <form asp-action="Record" method="post">
                                        <input type="hidden" name="activityId" value="@a.ActivityId" />
                                        <input type="hidden" name="date" value="@date" />
                                        <input type="hidden" name="status" value="NotCompleted" />
                                        <input type="hidden" name="notes" value="@a.Notes" />
                                        <button class="btn btn-soft-danger btn-sm"><i class="bi bi-x-lg me-1"></i>No completada</button>
                                    </form>
                                }
                                @if (hasRecord)
                                {
                                    <form asp-action="DeleteRecord" method="post" data-confirm="¿Borrar el registro? La actividad volverá a quedar pendiente / sin registro.">
                                        <input type="hidden" name="activityId" value="@a.ActivityId" />
                                        <input type="hidden" name="date" value="@date" />
                                        <button class="btn btn-soft btn-sm" title="Corregir: borrar registro"><i class="bi bi-arrow-counterclockwise me-1"></i>Deshacer</button>
                                    </form>
                                }
                            </div>
                            <details class="tf-more mt-2">
                                <summary><i class="bi bi-pencil-square me-1"></i>Completada con hora real y nota</summary>
                                <form asp-action="Record" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                                    <input type="hidden" name="activityId" value="@a.ActivityId" />
                                    <input type="hidden" name="date" value="@date" />
                                    <input type="hidden" name="status" value="Completed" />
                                    <input type="time" name="actualEndTime" class="form-control form-control-sm" style="width:auto" value="@(a.ActualEndTime?.ToString("HH:mm"))" aria-label="Hora real de término" />
                                    <input type="text" name="notes" maxlength="500" class="form-control form-control-sm flex-grow-1" style="min-width:10rem" placeholder="Nota (opcional)" value="@a.Notes" />
                                    <button class="btn btn-primary btn-sm">Guardar</button>
                                </form>
                            </details>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-xl-4">
        <div class="tf-card tf-card-body fade-up">
            <h3 class="tf-card-title"><i class="bi bi-cup-hot" style="color:var(--st-rest)"></i> Día de descanso</h3>
            @if (day.IsRestDay)
            {
                <p class="mb-3">Este día está marcado como <strong>descanso</strong>. @(day.Activities.Count > 0 ? "Los registros se conservan, pero el día cuenta como descanso." : "")</p>
                @if (Model.CanToggleRestDay)
                {
                    <form asp-action="RemoveRestDay" method="post">
                        <input type="hidden" name="date" value="@date" />
                        <button class="btn btn-soft-danger w-100"><i class="bi bi-x-circle me-1"></i>Quitar descanso</button>
                    </form>
                }
            }
            else if (Model.CanToggleRestDay)
            {
                <p class="text-muted small">Llevas <strong>@Model.RestDaysUsed de @Model.RestDayLimit</strong> descansos este mes.</p>
                <form asp-action="AddRestDay" method="post">
                    <input type="hidden" name="date" value="@date" />
                    <input type="text" name="notes" maxlength="200" class="form-control mb-2" placeholder="Nota (opcional)" />
                    <button class="btn btn-primary w-100" @(Model.RestDaysUsed >= Model.RestDayLimit ? "disabled" : "")>
                        <i class="bi bi-cup-hot me-1"></i>Marcar como descanso
                    </button>
                    @if (Model.RestDaysUsed >= Model.RestDayLimit)
                    {
                        <div class="form-text">Ya alcanzaste el límite del mes. Puedes subirlo desde el calendario.</div>
                    }
                </form>
            }
            else
            {
                <p class="text-muted mb-0">Los descansos solo se marcan o quitan de hoy en adelante.</p>
            }
        </div>
    </div>
</div>
