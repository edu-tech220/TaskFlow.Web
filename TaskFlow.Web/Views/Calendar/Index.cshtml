@model CalendarViewModel
@{
    var c = Model.Calendar;
    var stats = Model.Stats;
    ViewData["Title"] = Display.MonthTitle(c.Year, c.Month);
    ViewData["Subtitle"] = "Calendario de cumplimiento";
}

@section TopActions {
    <div class="btn-group">
        <a class="btn btn-soft" asp-action="Index" asp-route-year="@Model.PreviousMonth.Year" asp-route-month="@Model.PreviousMonth.Month" aria-label="Mes anterior"><i class="bi bi-chevron-left"></i></a>
        <a class="btn btn-soft" asp-action="Index">Hoy</a>
        <a class="btn btn-soft" asp-action="Index" asp-route-year="@Model.NextMonth.Year" asp-route-month="@Model.NextMonth.Month" aria-label="Mes siguiente"><i class="bi bi-chevron-right"></i></a>
    </div>
}

<div class="row g-4">
    <div class="col-xl-9">
        <div class="tf-card tf-card-body fade-up">
            <div class="tf-cal">
                @foreach (var day in Display.WeekMondayFirst)
                {
                    <div class="tf-cal-head">@Display.DayShort(day)</div>
                }

                @for (var i = 0; i < Model.LeadingBlanks; i++)
                {
                    <div class="tf-cal-cell empty"></div>
                }

                @foreach (var day in c.Days)
                {
                    var (label, css, icon) = Display.Of(day.Status);
                    var pct = day.ScheduledCount == 0 ? 0 : 100 * day.CompletedCount / day.ScheduledCount;
                    <a class="tf-cal-cell @css @(day.Date == c.Today ? "today" : "") @(day.IsRestDay ? "has-rest" : "")"
                       asp-action="Day" asp-route-date="@day.Date.ToString("yyyy-MM-dd")"
                       title="@Display.LongDate(day.Date): @label">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="tf-cal-day">@day.Date.Day</span>
                            <span class="d-flex gap-1">
                                @* Un descanso futuro sigue siendo "Próximo" (regla 1), pero se marca con su ícono. *@
                                @if (day.IsRestDay && day.Status != DayStatus.RestDay)
                                {
                                    <i class="bi bi-cup-hot tf-cal-rest" title="Descanso"></i>
                                }
                                <i class="bi @icon tf-cal-icon"></i>
                            </span>
                        </div>
                        <div class="tf-cal-label">@label</div>
                        @if (day.ScheduledCount > 0)
                        {
                            <div class="tf-cal-count">@day.CompletedCount de @day.ScheduledCount</div>
                            <div class="tf-progress"><div style="width:@pct%"></div></div>
                        }
                    </a>
                }
            </div>

            <div class="tf-legend mt-4">
                @foreach (var status in Enum.GetValues<DayStatus>())
                {
                    var (label, css, icon) = Display.Of(status);
                    <span class="st-chip @css"><i class="bi @icon"></i> @label</span>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-3">
        <div class="tf-card tf-card-body mb-4 fade-up">
            <h3 class="tf-card-title"><i class="bi bi-pie-chart text-primary"></i> Resumen del mes</h3>
            <div class="d-flex align-items-end gap-2 mb-2">
                <span class="tf-stat-value">@stats.CompletionPercent%</span>
                <span class="text-muted small mb-1">de cumplimiento</span>
            </div>
            <div class="tf-progress mb-3" style="--c: var(--st-completed); height: 8px"><div style="width:@stats.CompletionPercent%"></div></div>
            <div class="d-flex justify-content-between small py-1"><span class="text-muted">Actividades completadas</span><strong>@stats.Completed / @stats.Scheduled</strong></div>
            <div class="d-flex justify-content-between small py-1"><span class="text-muted">Días completos</span><strong style="color:var(--st-completed)">@stats.CompletedDays</strong></div>
            <div class="d-flex justify-content-between small py-1"><span class="text-muted">Días parciales</span><strong style="color:var(--st-partial)">@stats.PartialDays</strong></div>
            <div class="d-flex justify-content-between small py-1"><span class="text-muted">Días fallidos</span><strong style="color:var(--st-failed)">@stats.FailedDays</strong></div>
        </div>

        <div class="tf-card tf-card-body fade-up">
            <h3 class="tf-card-title"><i class="bi bi-cup-hot" style="color:var(--st-rest)"></i> Descansos</h3>
            <div class="d-flex align-items-end gap-2 mb-2">
                <span class="tf-stat-value">@c.RestDaysUsed</span>
                <span class="text-muted small mb-1">de @c.RestDayLimit usados</span>
            </div>
            <div class="tf-progress mb-3" style="--c: var(--st-rest); height: 8px">
                <div style="width:@(c.RestDayLimit == 0 ? 0 : Math.Min(100, 100 * c.RestDaysUsed / c.RestDayLimit))%"></div>
            </div>
            <form asp-action="SetLimit" method="post">
                <input type="hidden" name="year" value="@c.Year" />
                <input type="hidden" name="month" value="@c.Month" />
                <label class="form-label" for="maxRestDays">Límite del mes</label>
                <div class="input-group">
                    <input type="number" id="maxRestDays" name="maxRestDays" class="form-control" min="0" max="10" value="@c.RestDayLimit" />
                    <button type="submit" class="btn btn-soft">Guardar</button>
                </div>
                <div class="form-text">Entre 0 y 10; no menor a los ya usados. Marca descansos desde el detalle de cada día.</div>
            </form>
        </div>
    </div>
</div>
