@model string
@{
    ViewData["Title"] = "Algo salió mal";
}

<div class="tf-card tf-card-body text-center py-5 fade-up" style="max-width: 36rem; margin: 2rem auto">
    <div class="tf-stat-icon bg-soft-danger mx-auto mb-3"><i class="bi bi-plug"></i></div>
    <h2 class="h5">No se pudo completar la operación</h2>
    <p class="text-muted">@Model</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
