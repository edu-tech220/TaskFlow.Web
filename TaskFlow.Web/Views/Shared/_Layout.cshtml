@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var name = User.DisplayName();
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="tf-shell">
        @* offcanvas-lg: en pantallas grandes es una barra fija; en móvil, un panel deslizable. *@
        <aside class="tf-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Menú principal">
            <div class="offcanvas-body">
                <div class="d-flex align-items-center justify-content-between">
                    <a class="tf-brand" asp-controller="Home" asp-action="Index">
                        <span class="tf-logo"><i class="bi bi-check2-all"></i></span> TaskFlow
                    </a>
                    <button type="button" class="btn-close btn-close-white d-lg-none mb-3" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Cerrar"></button>
                </div>

                <div class="tf-nav-label">General</div>
                <ul class="tf-nav">
                    <li><a class="@Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i> Inicio</a></li>
                    <li><a class="@Active("Calendar")" asp-controller="Calendar" asp-action="Index"><i class="bi bi-calendar3"></i> Calendario</a></li>
                    <li><a class="@Active("Activities")" asp-controller="Activities" asp-action="Index"><i class="bi bi-list-check"></i> Actividades</a></li>
                </ul>

                <div class="tf-nav-label">Cuenta</div>
                <ul class="tf-nav">
                    <li><a class="@Active("Account", "Profile")" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i> Mi perfil</a></li>
                    @if (User.IsAdmin())
                    {
                        <li><a class="@Active("Admin")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> Usuarios</a></li>
                    }
                </ul>

                <div class="tf-user mt-4">
                    <div class="tf-avatar">@Display.Initials(name)</div>
                    <div class="flex-grow-1 min-w-0" style="min-width:0">
                        <div class="tf-user-name text-truncate">@name</div>
                        <div class="tf-user-mail text-truncate">@User.Email()</div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-link p-1" title="Cerrar sesión" aria-label="Cerrar sesión"><i class="bi bi-box-arrow-right fs-5"></i></button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="tf-main">
            <header class="tf-topbar">
                <button class="tf-icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Abrir menú">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="flex-grow-1 min-w-0">
                    <h1 class="text-truncate">@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string sub)
                    {
                        <div class="tf-sub">@sub</div>
                    }
                </div>
                @await RenderSectionAsync("TopActions", required: false)
                <button class="tf-icon-btn" type="button" data-theme-toggle title="Cambiar tema" aria-label="Cambiar tema">
                    <i data-theme-icon class="bi bi-moon-stars"></i>
                </button>
            </header>

            <main class="tf-content">
                @* Mensajes de una sola vez (TempData) después de un POST *@
                @if (TempData["Success"] is string ok)
                {
                    <div class="alert alert-success tf-alert alert-dismissible fade show fade-up" role="alert">
                        <i class="bi bi-check-circle-fill fs-5"></i><div class="flex-grow-1">@ok</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger tf-alert alert-dismissible fade show fade-up" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i><div class="flex-grow-1">@error</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
