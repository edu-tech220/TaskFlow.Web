@model ActivityFormViewModel
@{
    var isEdit = Model.Id is not null;
}

<div asp-validation-summary="All" class="alert alert-danger tf-alert mb-3"></div>

<div class="tf-card tf-card-body mb-4">
    <h3 class="tf-card-title"><i class="bi bi-info-circle text-primary"></i> Información</h3>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="100" placeholder="Ej. Gimnasio, Leer, Meditar" />
    </div>
    <div>
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2" maxlength="500" placeholder="Opcional"></textarea>
    </div>
</div>

<div class="tf-card tf-card-body mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="tf-card-title m-0"><i class="bi bi-calendar-week text-primary"></i> Horario</h3>
        @if (isEdit)
        {
            <div class="form-check form-switch m-0">
                <input asp-for="ChangeSchedule" class="form-check-input" role="switch" id="changeSchedule" />
                <label class="form-check-label small" for="changeSchedule">Cambiar horario</label>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="ChangeSchedule" />
        }
    </div>

    @if (isEdit)
    {
        <div class="alert tf-alert mb-3" style="background: var(--tf-primary-soft); color: var(--tf-primary)">
            <i class="bi bi-info-circle-fill"></i>
            <div class="small">El nuevo horario crea una <strong>versión</strong> que aplica a partir de mañana (o de la fecha que elijas). Hoy y los días pasados no cambian.</div>
        </div>
    }

    @* fieldset deshabilitado = sus campos no se envían (en edición, si no se cambia el horario) *@
    <fieldset id="scheduleFields">
        <div class="mb-3">
            <label class="form-label d-block">Días</label>
            <div class="tf-day-picker">
                @foreach (var day in Display.WeekMondayFirst)
                {
                    <input type="checkbox" class="btn-check" name="Days" value="@day" id="day-@day" autocomplete="off" @(Model.Days.Contains(day) ? "checked" : "") />
                    <label class="btn" for="day-@day" title="@Display.DayName(day)">@Display.DayShort(day)</label>
                }
            </div>
            <div class="d-flex gap-3 mt-2 small">
                <a href="#" data-days="1,2,3,4,5">Entre semana</a>
                <a href="#" data-days="0,6">Fin de semana</a>
                <a href="#" data-days="0,1,2,3,4,5,6">Todos</a>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-sm-4">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" type="time" class="form-control" value="@(Model.StartTime?.ToString("HH:mm"))" />
            </div>
            <div class="col-sm-4">
                <label asp-for="EndTime" class="form-label"></label>
                <input asp-for="EndTime" type="time" class="form-control" value="@(Model.EndTime?.ToString("HH:mm"))" />
            </div>
            <div class="col-sm-4">
                <label asp-for="EffectiveFrom" class="form-label"></label>
                <input asp-for="EffectiveFrom" type="date" class="form-control" value="@(Model.EffectiveFrom?.ToString("yyyy-MM-dd"))" />
                <div class="form-text">@(isEdit ? "Vacío = a partir de mañana." : "Vacío = hoy. Puede ser una fecha pasada.")</div>
            </div>
        </div>
    </fieldset>
</div>
