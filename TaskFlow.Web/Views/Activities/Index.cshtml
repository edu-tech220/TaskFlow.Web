@model List<ActivityDto>
@{
    ViewData["Title"] = "Actividades";
    var active = Model.Count(a => a.IsActive);
    ViewData["Subtitle"] = $"{active} activa{(active == 1 ? "" : "s")} · {Model.Count - active} inactiva{(Model.Count - active == 1 ? "" : "s")}";
}

@section TopActions {
    <a class="btn btn-primary d-inline-flex align-items-center gap-1" asp-action="Create"><i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline">Nueva actividad</span></a>
}

@if (Model.Count == 0)
{
    <div class="tf-card tf-card-body text-center py-5 fade-up">
        <div class="tf-stat-icon bg-soft-primary mx-auto mb-3"><i class="bi bi-list-check"></i></div>
        <h2 class="h5">Aún no tienes actividades</h2>
        <p class="text-muted">Crea tu primera actividad: elige los días y el horario en que quieres hacerla.</p>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Crear actividad</a>
    </div>
}

<div class="row g-3">
    @foreach (var a in Model.OrderByDescending(a => a.IsActive).ThenBy(a => a.CurrentSchedule?.StartTime))
    {
        var s = a.CurrentSchedule ?? a.Schedules.FirstOrDefault();
        <div class="col-md-6 col-xxl-4">
            <div class="tf-card tf-card-body tf-activity @(a.IsActive ? "" : "inactive") fade-up">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <div class="min-w-0">
                        <h3 class="tf-activity-name text-truncate">@a.Name</h3>
                        @if (!string.IsNullOrEmpty(a.Description))
                        {
                            <div class="text-muted small text-truncate">@a.Description</div>
                        }
                    </div>
                    @if (a.IsActive)
                    {
                        <span class="chip chip-success"><i class="bi bi-circle-fill" style="font-size:.5rem"></i> Activa</span>
                    }
                    else
                    {
                        <span class="chip chip-muted">Inactiva</span>
                    }
                </div>

                @if (s is not null)
                {
                    <div class="tf-time my-2"><i class="bi bi-clock text-primary"></i>@Display.Time(s.StartTime) – @Display.Time(s.EndTime)</div>
                    <div class="tf-days mb-2">
                        @foreach (var d in Display.WeekMondayFirst)
                        {
                            <span class="tf-day @(s.Days.Contains(d) && a.IsActive ? "on" : "")" title="@Display.DayName(d)">@Display.DayLetter(d)</span>
                        }
                    </div>
                    @if (a.IsActive && s.EffectiveFrom > DateOnly.FromDateTime(DateTime.Now))
                    {
                        <div class="small text-muted"><i class="bi bi-hourglass-split me-1"></i>Empieza el @Display.ShortDate(s.EffectiveFrom)</div>
                    }
                }

                <div class="d-flex gap-2 mt-auto pt-3">
                    <a class="btn btn-soft btn-sm flex-grow-1" asp-action="Edit" asp-route-id="@a.Id"><i class="bi bi-pencil me-1"></i>Editar</a>
                    <form asp-action="ToggleStatus" asp-route-id="@a.Id" method="post"
                          data-confirm="@(a.IsActive ? "¿Desactivar? Hoy sigue contando; deja de aplicar desde mañana." : "¿Reactivar a partir de mañana?")">
                        <input type="hidden" name="isActive" value="@((!a.IsActive).ToString().ToLowerInvariant())" />
                        <button class="btn btn-soft btn-sm" title="@(a.IsActive ? "Desactivar" : "Reactivar")">
                            <i class="bi @(a.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                        </button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post"
                          data-confirm="¿Eliminar &quot;@a.Name&quot;? Solo es posible si no tiene registros; si los tiene, desactívala.">
                        <button class="btn btn-soft-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
